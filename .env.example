# Optional: up.sh generates a password and detects DOCKER_GID if these are unset.
# Host port for Traefik's http entrypoint
# Host ports: HTTPS serves code-server, HTTP redirects to it
HTTPS_PORT=443
HTTP_PORT=80
# Hostname Traefik routes to code-server; must resolve to this machine
DEVBOX_HOST=code.localhost
# Hostname for the Traefik dashboard (basic auth: admin / CODER_PASSWORD)
TRAEFIK_HOST=traefik.localhost
# Hostname for Portainer (has its own login)
PORTAINER_HOST=portainer.localhost
# NETWORK_NAME=devbox_network
# CODER_PASSWORD=   (up.sh appends a generated one here)
# DOCKER_GID=
# CONTAINER_NAME=claude-browser-ubuntu
# VOLUME_NAME=claude_coder_home
# DOCKER_SOCK=/var/run/docker.sock
# Extra hostnames for the certificate, comma separated (*.localhost is always covered)
# EXTRA_HOSTS=app.example.test
